{
  "name": "photo-sorter",
  "version": "1.0.0",
  "private": true,
  "description": "Sort your photos with AI on your own computer: by type, day and place, with best shots, duplicates, a photo viewer and easy fixes.",
  "license": "MIT",
  "repository": "github:ashmitmittal/photo-sorter",
  "type": "module",
  "scripts": {
    "start": "node server.js --open",
    "serve": "node server.js",
    "sort": "node scripts/sort-cli.js",
    "snapshot": "node scripts/originals.js snapshot",
    "verify": "node scripts/originals.js verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "exifr": "7.1.3",
    "sharp": "0.35.5"
  },
  "optionalDependencies": {
    "heic-convert": "2.1.0"
  }
}
